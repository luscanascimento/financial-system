# FinanceHub environment configuration.
# Copy to `.env` and adjust. Every variable has a safe development default in
# docker-compose.yml, so `.env` is only needed to override secrets/ports.

# ----- Runtime -----
NODE_ENV=development
PORT=3000
API_GLOBAL_PREFIX=api
# Origin allowed by CORS (the web app served by nginx).
CORS_ORIGIN=http://localhost:8080

# ----- PostgreSQL -----
POSTGRES_USER=financehub
POSTGRES_PASSWORD=financehub
POSTGRES_DB=financehub
POSTGRES_PORT=5432
# Used by the API/Prisma. Host is the compose service name inside Docker.
DATABASE_URL=postgresql://financehub:financehub@localhost:5432/financehub?schema=public

# ----- Redis -----
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# ----- Authentication (used from Phase 1) -----
# CHANGE THESE IN PRODUCTION — the API refuses to boot in production with the
# development defaults.
JWT_ACCESS_SECRET=dev-access-secret-change-me-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32-characters
JWT_REFRESH_TTL=7d

# ----- Rate limiting -----
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# ----- Object storage (MinIO / S3) -----
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=financehub
MINIO_SECRET_KEY=financehub-secret
MINIO_BUCKET=financehub
MINIO_USE_SSL=false

# ----- Host port mappings (docker compose) -----
API_PORT=3000
WEB_PORT=8080
